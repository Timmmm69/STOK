generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Infrastructure-only marker proving that migrations and deterministic seed ran.
// Product data must never be added to this model.
model HarnessState {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("_harness_state")
}
