# Safe local-only defaults. Do not reuse these credentials outside Docker Compose.
DATABASE_URL=postgresql://stok:stok_local@localhost:55432/stok?schema=public
TEST_DATABASE_URL=postgresql://stok:stok_test@localhost:55433/stok_test?schema=public
HEALTH_DB_TIMEOUT_MS=1500
LOG_LEVEL=info

# Google login. Create Web OAuth credentials before manual sign-in.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
AUTH_ALLOWED_EMAIL=owner@example.com
